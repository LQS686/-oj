# MongoDB 连接字符串
DATABASE_URL=mongodb://localhost:27017/oj_platform

# JWT 密钥（必填，生产环境必须设置）
# 建议使用至少 32 个字符的随机字符串
# 生成方法: openssl rand -base64 32
JWT_SECRET=your-secure-random-string-at-least-32-characters-long

# 运行环境: development | production
NODE_ENV=development

# 时区（建议显式设置，确保日期时间处理一致；生产环境未设置时 lib/env.ts 会 warn）
TZ=Asia/Shanghai

# 服务端口
PORT=3000
# 服务绑定地址（Docker 内必须为 0.0.0.0，容器外无法访问）
# HOSTNAME=0.0.0.0

# 前端 URL（用于 CORS 配置）
FRONTEND_URL=http://localhost:3000

# 评测机配置（Linux / WSL / 容器；不支持 Windows 宿主本地评测）
# 也可在后台「系统设置 → 评测设置」中调整；此处环境变量优先级更高（适合 Docker 部署覆盖）
# 超时容差比例（0 = 严格按 timeLimit，不加余量）
JUDGE_EXTRA_TIME_RATIO=0
# 临界 TLE 重测次数（0 = 关闭重测）
JUDGE_REJUDGE_TIMES=1
# 评测并发数（跨提交）：4 核部署推荐 1（与后台「系统设置 → 评测设置」一致；8 核可调 2-3）
JUDGE_MAX_CONCURRENT=1
# 4G 内存宿主注意：并发过高 + 大内存题叠加会导致宿主/容器 OOM（误杀 mongo 或评测进程）。
# 建议并发 = min(3, (总内存 - 基础设施 - 0.6G 余量) / 最大题目内存限制)；见 lib/judge/memory-gate.ts。
# 评测内存门控：宿主可用内存低于该值（MB）时暂停派发新评测，等待内存恢复（防 OOM 连锁）
# JUDGE_MIN_FREE_MEM_MB=512
# 同提交测点并行度：4 核部署推荐 3（注意：这是评测实际总并行度，large 槽位在其内部再限流；
# 若小于 largeCaseConcurrency 则大测点并行不生效）
JUDGE_CASE_CONCURRENCY=3
# 大 I/O 测点并行度（百万行 input/output 测点全走此槽位；4 核推荐 3，过低会排队放大总耗时）
JUDGE_LARGE_CASE_CONCURRENCY=3
# 判定「大测点」的字节阈值（输入或输出，默认 2MiB）
# JUDGE_LARGE_CASE_BYTES=2097152
# 正式评测 fail-fast（默认 off = 跑完全部测点，OI 全量计分）
# ACM/课堂希望遇 TLE 尽快出结果时可设 hard：
#   hard = TLE/MLE/RE 等后中止剩余
#   all  = 任意非 AC 即停（类 ACM）
# JUDGE_FAIL_FAST=off
# 编译超时（毫秒，默认 20000）
JUDGE_COMPILE_TIMEOUT=20000
# 单任务最大评测时长（秒，默认 300）；超时会 abort 选手进程并标 SE，不再空占槽位
# 大测点+重测场景可适当调高（如 30 测点 * 5s * 3 重测 = 450s，建议设 600）
JUDGE_JOB_TIMEOUT=300
# 死任务扫描间隔（毫秒，默认 5000）；配合任务级定时器，超时后尽快释放队列
# JUDGE_DEAD_CHECK_MS=5000
# 大输出题墙钟 I/O 裕量上限（毫秒，默认 30000）；过大易让暴力解长时间卡在「评测中」
# JUDGE_IO_SLACK_MAX_MS=30000
# close 事件兜底等待（毫秒，默认 500）
# JUDGE_CLOSE_FALLBACK_MS=500
# 洛谷式默认：不启用 ASan/UBSan（计时接近教学 OJ；大 I/O 题明显更快）
# 竞赛严检可显式打开（建议同时把题目 memoryLimit 调到 256MB+）
# JUDGE_ENABLE_ASAN=true
# JUDGE_ENABLE_UBSAN=true

# Redis 连接（生产强制；本地强烈建议）
# 用途：业务缓存、限流、头像分片上传会话、登录失败锁定、多实例鉴权吊销戳
# 未配置时：生产启动失败；本地相关能力降级或不可用
# REDIS_URL=redis://localhost:6379

# =========================================================
# MongoDB / Redis 容器凭证（docker-compose 部署使用）
# =========================================================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=ojuser
MONGO_APP_PASSWORD=
REDIS_PASSWORD=

# =========================================================
# 日志与前端配置
# =========================================================
# 日志级别: debug | info | warn | error
LOG_LEVEL=info
# WebSocket 单 IP 每分钟最大连接数（默认 30；校园/机房 NAT 多人共享出口 IP 时不宜过低）
# WS_MAX_CONNECTIONS_PER_MIN=30
# Socket.IO 客户端连接地址（构建期必需）
NEXT_PUBLIC_API_URL=http://localhost:3000
# 站点基础 URL（sitemap.ts 使用，构建期必需）
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# =========================================================
# 安全配置
# =========================================================
# 受信任的反向代理层数（影响 X-Forwarded-For 解析，rate-limit 使用）
TRUSTED_PROXIES=1
# 强制 Cookie Secure 标志
# 生产环境禁止设为 false（lib/env.ts 会拒绝启动）
# 非生产但已挂 HTTPS 反向代理时可设为 true
# FORCE_SECURE_COOKIE=true
# 强制启用 HSTS（Strict-Transport-Security）响应头；仅显式设为 true 时生效，
# 避免 HTTP 部署被浏览器强制升级（next.config.ts 读取）
# FORCE_HSTS=true

# 通用加密密钥（SMTP 授权码等；生产强制）
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 未配置时：生产启动失败；开发环境加密写入会抛错，读取路径降级为显示 ********
ENCRYPTION_KEY=

# =========================================================
# 测试与脚本专用（仅本地/CI 使用，不影响生产）
# =========================================================
# 冒烟测试管理员账号（tests/api.test.ts 登录用，需与 seed 数据一致）
# TEST_ADMIN_EMAIL=admin@dsoj.run
# TEST_ADMIN_PASSWORD=admin123456
# 页面冒烟脚本基础地址（scripts/_smoke-user-pages.mjs 使用）
# SMOKE_BASE=http://localhost:3000
# 评测 runner 路径（lib/env.ts 启动日志展示用，可选）
# JUDGE_RUNNER_PATH=/app/lib/judge/runner.sh
