# MongoDB 连接字符串
DATABASE_URL=mongodb://localhost:27017/oj-platform

# JWT 密钥（必填，生产环境必须设置）
# 建议使用至少 32 个字符的随机字符串
# 生成方法: openssl rand -base64 32
JWT_SECRET=your-secure-random-string-at-least-32-characters-long

# 运行环境: development | production
NODE_ENV=development

# 时区（建议显式设置，确保日期时间处理一致；生产环境未设置时 lib/env.ts 会 warn）
TZ=Asia/Shanghai

# 服务端口
PORT=3000

# 前端 URL（用于 CORS 配置）
FRONTEND_URL=http://localhost:3000

# Docker 部署标识（Docker 部署时自动设置）
# USE_DOCKER=true

# 评测机配置
# 超时容差比例（0.1 = 时间限制的 10%，最小 2000ms 基准）
JUDGE_EXTRA_TIME_RATIO=0.1
# 临界 TLE 重测次数（0 = 关闭重测）
JUDGE_REJUDGE_TIMES=1
# 评测并发数（跨提交；CPU 密集时建议 1，避免计时抖动）
JUDGE_MAX_CONCURRENT=1
# 同提交/自测样例并行度（默认自动 min(8,max(4,CPU核数))；设 1 退回串行）
# JUDGE_CASE_CONCURRENCY=8
# 大 I/O 测点并行度（默认 2；LP3383 等高并发反而更慢）
# JUDGE_LARGE_CASE_CONCURRENCY=2
# 判定「大测点」的字节阈值（输入或输出，默认 2MiB）
# JUDGE_LARGE_CASE_BYTES=2097152
# 正式评测 fail-fast（默认 off = 跑完全部测点，OI 全量计分）
# 不要因 TLE/WA 等跳过剩余测点。仅特殊赛制可显式开启：
#   hard = TLE/MLE/RE 等后中止剩余
#   all  = 任意非 AC 即停（类 ACM）
# JUDGE_FAIL_FAST=off
# 编译超时（毫秒，默认 20000）
JUDGE_COMPILE_TIMEOUT=20000
# 单任务最大评测时长（秒，默认 300），超时强制标记失败
# 大测点+重测场景可适当调高（如 30 测点 * 5s * 3 重测 = 450s，建议设 600）
JUDGE_JOB_TIMEOUT=300
# 洛谷式默认：不启用 ASan/UBSan（计时接近教学 OJ；大 I/O 题明显更快）
# 竞赛严检可显式打开（建议同时把题目 memoryLimit 调到 256MB+）
# JUDGE_ENABLE_ASAN=true
# JUDGE_ENABLE_UBSAN=true

# Redis 连接（可选，用于队列）
# REDIS_URL=redis://localhost:6379

# =========================================================
# MongoDB / Redis 容器凭证（docker-compose 部署使用）
# =========================================================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=ojuser
MONGO_APP_PASSWORD=
REDIS_PASSWORD=

# =========================================================
# 日志与前端配置
# =========================================================
# 日志级别: debug | info | warn | error
LOG_LEVEL=info
# Socket.IO 客户端连接地址（构建期必需）
NEXT_PUBLIC_API_URL=http://localhost:3000
# 站点基础 URL（sitemap.ts 使用，构建期必需）
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# =========================================================
# 安全配置
# =========================================================
# 受信任的反向代理层数（影响 X-Forwarded-For 解析，rate-limit 使用）
TRUSTED_PROXIES=1
# 强制 Cookie Secure 标志（非生产环境部署在 HTTPS 后时设为 true）
# FORCE_SECURE_COOKIE=true

# 通用加密密钥（用于 SMTP 授权码等敏感配置加密；32 字节，base64 推荐）
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 未配置时加密写入会抛错，读取路径降级为显示 ********
ENCRYPTION_KEY=
